<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RutGeo.UI.ViewModels"
             x:DataType="vm:MainWindowViewModel"
             x:Class="RutGeo.UI.Views.Solutions">

    <StackPanel Spacing="8">

        <StackPanel x:Name="ConicSolutions" IsVisible="True" Spacing="6">
            <Border Background="{StaticResource InfoBackgroundBrush}" CornerRadius="4" Padding="10">
                <StackPanel Spacing="6">
                    <TextBlock Text="Centro:" FontWeight="SemiBold" Foreground="{StaticResource LabelForegroundBrush}"/>
                    <TextBlock Text="{Binding ConicVM.ExpectedCenter}" Foreground="{StaticResource AccentForegroundBrush}" FontWeight="Bold"/>
                    <Separator Background="{StaticResource BorderBrush}" Height="1"/>

                    <TextBlock Text="Vértices:" FontWeight="SemiBold" Foreground="{StaticResource LabelForegroundBrush}"/>
                    <TextBlock Text="{Binding ConicVM.ExpectedVertices}" Foreground="{StaticResource AccentForegroundBrush}" FontWeight="Bold" TextWrapping="Wrap"/>
                    <Separator Background="{StaticResource BorderBrush}" Height="1"/>

                    <TextBlock Text="Focos:" FontWeight="SemiBold" Foreground="{StaticResource LabelForegroundBrush}"/>
                    <TextBlock Text="{Binding ConicVM.ExpectedFocals}" Foreground="{StaticResource AccentForegroundBrush}" FontWeight="Bold" TextWrapping="Wrap"/>
                    <Separator Background="{StaticResource BorderBrush}" Height="1"/>

                    <TextBlock Text="Eje mayor / Eje menor:" FontWeight="SemiBold" Foreground="{StaticResource LabelForegroundBrush}"/>
                    <TextBlock Text="{Binding ConicVM.ExpectedAxis}" Foreground="{StaticResource AccentForegroundBrush}" FontWeight="Bold" TextWrapping="Wrap"/>
                    <Separator Background="{StaticResource BorderBrush}" Height="1"/>

                    <TextBlock Text="Directriz:" FontWeight="SemiBold" Foreground="{StaticResource LabelForegroundBrush}"/>
                    <TextBlock Text="{Binding ConicVM.ExpectedDirective}" Foreground="{StaticResource AccentForegroundBrush}" FontWeight="Bold" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel x:Name="LimitSolutions" IsVisible="False" Spacing="6">
            <Border Background="{StaticResource InfoBackgroundBrush}" CornerRadius="4" Padding="10">
                <StackPanel Spacing="6">
                    <TextBlock Text="Límite por la izquierda:" FontWeight="SemiBold" Foreground="{StaticResource LabelForegroundBrush}"/>
                    <TextBlock Text="{Binding LimitVM.ExpectedLeftLimit}" Foreground="{StaticResource AccentForegroundBrush}" FontWeight="Bold"/>
                    <Separator Background="{StaticResource BorderBrush}" Height="1"/>

                    <TextBlock Text="Límite por la derecha:" FontWeight="SemiBold" Foreground="{StaticResource LabelForegroundBrush}"/>
                    <TextBlock Text="{Binding LimitVM.ExpectedRightLimit}" Foreground="{StaticResource AccentForegroundBrush}" FontWeight="Bold"/>
                    <Separator Background="{StaticResource BorderBrush}" Height="1"/>

                    <TextBlock Text="¿Existe el límite?:" FontWeight="SemiBold" Foreground="{StaticResource LabelForegroundBrush}"/>
                    <TextBlock Text="{Binding LimitVM.ExpectedLimitExists}" Foreground="{StaticResource AccentForegroundBrush}" FontWeight="Bold"/>
                    <Separator Background="{StaticResource BorderBrush}" Height="1"/>

                    <TextBlock Text="Valor de f(a):" FontWeight="SemiBold" Foreground="{StaticResource LabelForegroundBrush}"/>
                    <TextBlock Text="{Binding LimitVM.ExpectedValueFA}" Foreground="{StaticResource AccentForegroundBrush}" FontWeight="Bold"/>
                    <Separator Background="{StaticResource BorderBrush}" Height="1"/>

                    <TextBlock Text="¿Es continua?:" FontWeight="SemiBold" Foreground="{StaticResource LabelForegroundBrush}"/>
                    <TextBlock Text="{Binding LimitVM.ExpectedContinuous}" Foreground="{StaticResource AccentForegroundBrush}" FontWeight="Bold"/>
                    <Separator Background="{StaticResource BorderBrush}" Height="1"/>

                    <TextBlock Text="Tipo de discontinuidad:" FontWeight="SemiBold" Foreground="{StaticResource LabelForegroundBrush}"/>
                    <TextBlock Text="{Binding LimitVM.ExpectedDiscontinuity}" Foreground="{StaticResource AccentForegroundBrush}" FontWeight="Bold"/>
                    <Separator Background="{StaticResource BorderBrush}" Height="1"/>

                    <TextBlock Text="Justificación:" FontWeight="SemiBold" Foreground="{StaticResource LabelForegroundBrush}"/>
                    <TextBlock Text="{Binding LimitVM.ExpectedJustification}" Foreground="{StaticResource AccentForegroundBrush}" FontWeight="Bold" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>

    </StackPanel>
</UserControl>