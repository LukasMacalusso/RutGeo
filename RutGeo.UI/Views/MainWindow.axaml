<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RutGeo.UI.ViewModels"
        xmlns:v="using:RutGeo.UI.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalonia="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
        x:Class="RutGeo.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="RutGeo"
        Width="1200" Height="800">
    
    <Window.Background>
        <StaticResource ResourceKey="WindowBackgroundBrush"/>
    </Window.Background>
    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *">
            
            <Border x:Name="LeftPanel" Grid.Column="0" Width="300" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto, *, Auto">
                    <Border Grid.Row="0" Background="{StaticResource HeaderBackgroundBrush}" Padding="15,14">
                        <TextBlock x:Name="ModeHeader" Text="CÓNICAS" Foreground="{StaticResource HeaderForegroundBrush}" HorizontalAlignment="Center" FontWeight="Bold" FontSize="22"/>
                    </Border>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,5" Spacing="5">
                            <TextBlock Text="ANÁLISIS" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryLightBrush}" Margin="5,5,0,0" HorizontalAlignment="Left"/>
                            <v:Analysis x:Name="AnalysisView" />
                            
                            <Separator Background="{StaticResource BorderBrush}" Height="1" Margin="0,10"/>
                            
                            <TextBlock Text="DEFENSA" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryLightBrush}" Margin="5,5,0,0" HorizontalAlignment="Left"/>
                            <v:Defense x:Name="DefenseView" />

                            <v:Solutions x:Name="SolutionsView" IsVisible="{Binding IsSolutionsVisible}" />
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Padding="10" Background="{StaticResource InputBackgroundBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <v:RutInputView x:Name="InputView" />
                            <v:RutLog x:Name="LogView" IsVisible="False" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            
            <Grid Grid.Column="1" RowDefinitions="Auto, *, Auto">
    
                <Border Grid.Row="0" Background="{StaticResource HeaderBackgroundBrush}" Padding="15,10">
                    <Grid>
 
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="15">
                            
                            <Button x:Name="TogglePanelBtn" 
                                    Content="☰" 
                                    Click="TogglePanelButton_Click" 
                                    Background="Transparent" 
                                    Foreground="{StaticResource HeaderForegroundBrush}" 
                                    FontSize="20" 
                                    Padding="5,0,5,5"
                                    Cursor="Hand"/>
 
                            <TextBlock VerticalAlignment="Center" FontSize="26">
                                <Run Text="Rut" FontWeight="Black" Foreground="{StaticResource HeaderForegroundBrush}"/><Run Text="Geo" FontWeight="Light" Foreground="{StaticResource PrimaryLightBrush}"/>
                            </TextBlock>
                        </StackPanel>
            
                        <StackPanel HorizontalAlignment="Right" 
                                     VerticalAlignment="Center" 
                                     Orientation="Horizontal"> 
                            <v:Mode x:Name="ModeSelector" /> 
                        </StackPanel>
                    </Grid>
                </Border>
                
                <Border Grid.Row="1" Background="{StaticResource PlotBackgroundBrush}">
                    <v:Graphic x:Name="GraphicView" />
                </Border>
                
                <v:ValuesTable x:Name="ValuesTableView" Grid.Row="2" IsVisible="False" />
 
            </Grid>
            
        </Grid>
    </Grid>
</Window>