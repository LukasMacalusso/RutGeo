<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RutGeo.UI.ViewModels"
             x:DataType="vm:MainWindowViewModel"
             x:CompileBindings="False"
             x:Class="RutGeo.UI.Views.Mode">
    <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Limpiar todo"
                Command="{Binding ClearAllCommand}"
                Background="{StaticResource DangerBrush}"
                Foreground="{StaticResource HeaderForegroundBrush}"
                BorderThickness="0"
                CornerRadius="3"
                Margin="0,0,10,0"/>
        <Button x:Name="BtnLimits" Content="Límites" Click="LimitsButton_Click" 
                Background="{StaticResource InactiveBrush}" Foreground="{StaticResource InactiveForegroundBrush}" BorderThickness="0"/>
        <Button x:Name="BtnConics" Content="Cónicas" Click="ConicsButton_Click" 
                Background="{StaticResource PrimaryLightBrush}" Foreground="{StaticResource HeaderForegroundBrush}" BorderThickness="0" CornerRadius="3"/>
    </StackPanel>
</UserControl>
