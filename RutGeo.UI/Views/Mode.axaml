<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RutGeo.UI.ViewModels"
             x:DataType="vm:MainWindowViewModel"
             x:CompileBindings="False"
             x:Class="RutGeo.UI.Views.Mode">
    <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Limpiar todo"
                Command="{Binding ClearAllCommand}"
                Background="#D45050"
                Foreground="White"
                BorderThickness="0"
                CornerRadius="3"
                Margin="0,0,10,0"/>
        <Button x:Name="BtnLimits" Content="Límites" Click="LimitsButton_Click" 
                Background="#3A205E" Foreground="LightGray" BorderThickness="0"/>
        <Button x:Name="BtnConics" Content="Cónicas" Click="ConicsButton_Click" 
                Background="MediumSlateBlue" Foreground="White" BorderThickness="0" CornerRadius="3"/>
    </StackPanel>
</UserControl>
