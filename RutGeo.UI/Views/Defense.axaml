<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RutGeo.UI.ViewModels"
             x:DataType="vm:MainWindowViewModel"
             x:Class="RutGeo.UI.Views.Defense">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="15" Spacing="10">

            <StackPanel x:Name="ConicDefense" IsVisible="True" Spacing="8">
                <TextBlock Text="Centro (h, k):" FontWeight="SemiBold" Foreground="#555555"/>
                <Grid ColumnDefinitions="*, Auto">
                    <TextBox Grid.Column="0" Margin="0,0,5,5" Text="{Binding ConicVM.UserCenter}"/>
                    <TextBlock Grid.Column="1" Text="{Binding ConicVM.CenterStatus}" VerticalAlignment="Center" Foreground="Green" Margin="0,0,0,5"/>
                </Grid>

                <TextBlock Text="Vértices:" FontWeight="SemiBold" Foreground="#555555"/>
                <Grid ColumnDefinitions="*, Auto">
                    <TextBox Grid.Column="0" Margin="0,0,5,5" Text="{Binding ConicVM.UserVertices}"/>
                    <TextBlock Grid.Column="1" Text="{Binding ConicVM.VerticesStatus}" VerticalAlignment="Center" Foreground="Green" Margin="0,0,0,5"/>
                </Grid>

                <TextBlock Text="Focos:" FontWeight="SemiBold" Foreground="#555555"/>
                <Grid ColumnDefinitions="*, Auto">
                    <TextBox Grid.Column="0" Margin="0,0,5,5" Text="{Binding ConicVM.UserFocals}"/>
                    <TextBlock Grid.Column="1" Text="{Binding ConicVM.FocalsStatus}" VerticalAlignment="Center" Foreground="Green" Margin="0,0,0,5"/>
                </Grid>

                <TextBlock Text="Eje mayor / Eje menor:" FontWeight="SemiBold" Foreground="#555555"/>
                <Grid ColumnDefinitions="*, Auto">
                    <TextBox Grid.Column="0" Margin="0,0,5,5" Text="{Binding ConicVM.UserAxis}"/>
                    <TextBlock Grid.Column="1" Text="{Binding ConicVM.AxisStatus}" VerticalAlignment="Center" Foreground="Green" Margin="0,0,0,5"/>
                </Grid>

                <TextBlock Text="Directriz:" FontWeight="SemiBold" Foreground="#555555"/>
                <Grid ColumnDefinitions="*, Auto">
                    <TextBox Grid.Column="0" Margin="0,0,5,5" Text="{Binding ConicVM.UserDirective}"/>
                    <TextBlock Grid.Column="1" Text="{Binding ConicVM.DirectiveStatus}" VerticalAlignment="Center" Foreground="Green" Margin="0,0,0,5"/>
                </Grid>
            </StackPanel>

            <StackPanel x:Name="LimitDefense" IsVisible="False" Spacing="8">
                <TextBlock Text="Límite por la izquierda (x → a⁻):" FontWeight="SemiBold" Foreground="#555555"/>
                <Grid ColumnDefinitions="*, Auto">
                    <TextBox Grid.Column="0" Margin="0,0,5,5" Text="{Binding LimitVM.UserLeftLimit}"/>
                    <TextBlock Grid.Column="1" Text="{Binding LimitVM.LeftLimitStatus}" VerticalAlignment="Center" Foreground="Green" Margin="0,0,0,5"/>
                </Grid>

                <TextBlock Text="Límite por la derecha (x → a⁺):" FontWeight="SemiBold" Foreground="#555555"/>
                <Grid ColumnDefinitions="*, Auto">
                    <TextBox Grid.Column="0" Margin="0,0,5,5" Text="{Binding LimitVM.UserRightLimit}"/>
                    <TextBlock Grid.Column="1" Text="{Binding LimitVM.RightLimitStatus}" VerticalAlignment="Center" Foreground="Green" Margin="0,0,0,5"/>
                </Grid>

                <TextBlock Text="¿Existe el límite?" FontWeight="SemiBold" Foreground="#555555"/>
                <Grid ColumnDefinitions="*, Auto">
                    <ComboBox Grid.Column="0" ItemsSource="{Binding LimitVM.YesNoOptions}" SelectedItem="{Binding LimitVM.UserLimitExists}" HorizontalAlignment="Stretch" Margin="0,0,5,5"/>
                    <TextBlock Grid.Column="1" Text="{Binding LimitVM.LimitExistsStatus}" VerticalAlignment="Center" Foreground="Green" Margin="5,0,0,0"/>
                </Grid>

                <TextBlock Text="Valor de f(a):" FontWeight="SemiBold" Foreground="#555555"/>
                <Grid ColumnDefinitions="*, Auto">
                    <TextBox Grid.Column="0" Margin="0,0,5,5" Text="{Binding LimitVM.UserValueFA}"/>
                    <TextBlock Grid.Column="1" Text="{Binding LimitVM.ValueFAStatus}" VerticalAlignment="Center" Foreground="Green" Margin="0,0,0,5"/>
                </Grid>

                <TextBlock Text="¿Es continua?" FontWeight="SemiBold" Foreground="#555555"/>
                <Grid ColumnDefinitions="*, Auto">
                    <ComboBox Grid.Column="0" ItemsSource="{Binding LimitVM.YesNoOptions}" SelectedItem="{Binding LimitVM.UserContinuous}" HorizontalAlignment="Stretch" Margin="0,0,5,5"/>
                    <TextBlock Grid.Column="1" Text="{Binding LimitVM.ContinuousStatus}" VerticalAlignment="Center" Foreground="Green" Margin="5,0,0,0"/>
                </Grid>

                <TextBlock Text="Tipo de discontinuidad:" FontWeight="SemiBold" Foreground="#555555"/>
                <Grid ColumnDefinitions="*, Auto">
                    <ComboBox Grid.Column="0" ItemsSource="{Binding LimitVM.DiscontinuityOptions}" SelectedItem="{Binding LimitVM.UserDiscontinuity}" HorizontalAlignment="Stretch" Margin="0,0,5,5"/>
                    <TextBlock Grid.Column="1" Text="{Binding LimitVM.DiscontinuityStatus}" VerticalAlignment="Center" Foreground="Green" Margin="5,0,0,0"/>
                </Grid>
            </StackPanel>

            <Button x:Name="BtnCorroborate" Content="Corroborar" 
                    Command="{Binding CorroborateAllCommand}"
                    Background="MediumSlateBlue" Foreground="White" BorderThickness="0" 
                    CornerRadius="3" Padding="10" Margin="0,10,0,0"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />

            <Button x:Name="BtnSolutions" Content="Solucionario" 
                    Command="{Binding ToggleSolutionsCommand}"
                    Background="#7B68EE" Foreground="White" BorderThickness="0" 
                    CornerRadius="3" Padding="10"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />

        </StackPanel>
    </ScrollViewer>
</UserControl>